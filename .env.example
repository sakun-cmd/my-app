# Application database. This database is managed by Alembic.
DATABASE_URL=postgresql+psycopg://boat:boat@localhost:5432/boat_analysis

# Existing database. Use a role with SELECT permission only.
SOURCE_DATABASE_URL=postgresql+psycopg://readonly:change-me@host.docker.internal:5432/source_database
SOURCE_SCHEMA=public

# Optional source mapping file created after running the schema inspection.
SOURCE_MAPPING_PATH=/app/config/source-mapping.json

APP_ENV=development
APP_TIMEZONE=Asia/Tokyo
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Official result pages are checked only after the scheduled close plus this delay.
OFFICIAL_RESULT_FETCH_ENABLED=true
OFFICIAL_RESULT_DELAY_MINUTES=15
OFFICIAL_RESULT_RETRY_MINUTES=5
OFFICIAL_RESULT_POLL_SECONDS=60
OFFICIAL_RESULT_MAX_REQUESTS_PER_REFRESH=12
OFFICIAL_RESULT_REQUEST_INTERVAL_SECONDS=0.5
OFFICIAL_EXHIBITION_FETCH_ENABLED=true
OFFICIAL_EXHIBITION_LEAD_MINUTES=5
OFFICIAL_EXHIBITION_RETRY_MINUTES=1
OFFICIAL_EXHIBITION_TIMEOUT_SECONDS=20
OFFICIAL_EXHIBITION_MAX_REQUESTS_PER_REFRESH=12
OFFICIAL_EXHIBITION_REQUEST_INTERVAL_SECONDS=1.0
OFFICIAL_TRIFECTA_ODDS_FETCH_ENABLED=true
OFFICIAL_TRIFECTA_ODDS_LEAD_MINUTES=3
OFFICIAL_TRIFECTA_ODDS_RETRY_MINUTES=1
OFFICIAL_TRIFECTA_ODDS_TIMEOUT_SECONDS=20
OFFICIAL_TRIFECTA_ODDS_MAX_REQUESTS_PER_REFRESH=12
OFFICIAL_TRIFECTA_ODDS_REQUEST_INTERVAL_SECONDS=1.0
BOATCAST_LAP_FETCH_ENABLED=true
BOATCAST_LAP_TIMEOUT_SECONDS=20
BOATCAST_LAP_MAX_REQUESTS_PER_REFRESH=12
BOATCAST_LAP_REQUEST_INTERVAL_SECONDS=1.0
DAILY_EXCEL_ENABLED=true
DAILY_EXCEL_HOUR_JST=0
DAILY_EXCEL_MINUTE_JST=30
DAILY_EXCEL_OUTPUT_DIR=/app/exports

# Optional Telegram alert when a new ticket candidate is created.
# Keep the token and chat ID only in .env; never commit real values.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATION_TIMEOUT_SECONDS=10
TELEGRAM_NOTIFICATION_RETRY_MINUTES=5
TELEGRAM_NOTIFICATION_LATE_GRACE_MINUTES=5
